{
  "name": "ptv-gtfsr-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Local proxy for PTV GTFS Realtime feeds",
  "main": "server.js",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --experimental-test-coverage --test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "compression": "^1.7.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "gtfs-realtime-bindings": "^1.0.0",
    "helmet": "^7.1.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5"
  }
}
