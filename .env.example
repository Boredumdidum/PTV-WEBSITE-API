# PTV Open Data API subscription key (required)
PTV_API_KEY=

# Port the Express server listens on (default: 3000)
PORT=3000

# Feed cache TTL in milliseconds (default: 30000)
CACHE_TTL_MS=30000

# Upstream fetch timeout in milliseconds (default: 15000)
REQUEST_TIMEOUT_MS=15000

# Pino log level: fatal, error, warn, info, debug, trace (default: info)
LOG_LEVEL=info

# Metrics IP allowlist: comma-separated IPs, "*" for all, or empty for private ranges only (default: private + loopback)
# When empty, allows 127.0.0.1, ::1, and private ranges (10.x.x.x, 172.16-31.x.x, 192.168.x.x)
METRICS_ALLOW_IPS=
